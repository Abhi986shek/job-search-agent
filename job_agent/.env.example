# Copy to job_agent/.env (setup.ps1 does this) and fill in values. Never commit .env.

# Backend
APP_ENV=local
LOG_FILE=app.log
HOST=127.0.0.1
PORT=8001
# Shared token the frontend sends as X-API-Token. setup.ps1 generates it.
BACKEND_API_TOKEN=

# Database and secrets
# Empty DATABASE_URL = data/job_agent.db
DATABASE_URL=
# Fernet key used to encrypt the Gmail token. setup.ps1 generates it.
ENCRYPTION_KEY=

# Job sources
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
# Discovery may bill per returned job; keep small until measured.
PREDICTLEADS_DISCOVER_LIMIT=25
SERPAPI_API_KEY=
# Each page is one SerpApi search (about 10 jobs).
SERPAPI_MAX_PAGES=1
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# freehire public job API. No key needed. Country is an ISO code.
# Optional: comma-separated freehire source names to drop, e.g. naukri,telegram. Empty keeps all.
FREEHIRE_COUNTRY=IN
FREEHIRE_EXCLUDE_SOURCES=
# Pages of 100 read per search (one request each).
FREEHIRE_MAX_PAGES=3

# GitHub (read-only fine-grained tokens)
GITHUB_PERSONAL_TOKEN=
GITHUB_PERSONAL_USERNAME=
GITHUB_COMPANY_TOKEN=
GITHUB_COMPANY_ORG=

# LinkedIn (your own profile only)
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
LINKEDIN_PROFILE_URL=

# Contact finder
APOLLO_API_KEY=

# Personal Gmail
GMAIL_ADDRESS=
# Absolute path to the Google OAuth "Desktop app" client JSON. Keep it outside this folder.
GMAIL_OAUTH_CLIENT_FILE=
EMAIL_DAILY_SEND_CAP=20
REPLY_CHECK_MINUTES=15

# SMTP and IMAP fallback (only if you skip Gmail OAuth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# AWS Bedrock
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
